Private Sub chkPressureLoopActive_Click()
'// "loop_PSI",   ALL Pressure FeedBack LOOPS  (changes "Pressure_Contr_On_eq_1_Bit" in SysData.ControlWord) //?? Should ve save it to SysData ???
    If Init_sys_data = True Then Exit Sub 'avoid firing control event subroutine during initialization when values assigned
    If chkPressureLoopActive.Value = Checked Then
        chkPressureLoopActive.Caption = "Pressure Loops Enabled"
        Call Analyzer.GetSend(chkPressureLoopActive.Tag & ">active", True)
    Else
        chkPressureLoopActive.Caption = "Pressure Loops PASSIVE"
        Call Analyzer.GetSend(chkPressureLoopActive.Tag & ">passive", True)
    End If
End Sub

