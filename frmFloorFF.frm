Sub Refresh_gains()
    Dim i As Long
    Dim sep_pos As Long
    Dim gain_cmd As String
    Dim controller_param As String
    Dim paramValue As Single
    Dim max_indx As Long
    
    Init_sys_data = True
    If (ConnectionType = ConnDEMO) Then Exit Sub
    
' read FB gains and pressure settings
    max_indx = cwNumFBgain.UBound
    For i = 0 To max_indx
        controller_param = Analyzer.GetSend(cwNumFBgain(i).Tag, True)
        sep_pos = InStr(controller_param, "=")
        If (sep_pos <> 0) Then
            retval = Mid(controller_param, sep_pos + 1)
            sep_pos = InStr(retval, "//") ''if verbose response
            If (sep_pos <> 0) Then
                retval = Left(retval, sep_pos - 1)
            End If
            If IsNumber(retval) Then
                paramValue = Val(retval)
                cwNumFBgain(i).Value = paramValue
                If paramValue <> 0 Then
                    cwNumFBgain(i).FormatString = ".00"
                Else
                    cwNumFBgain(i).FormatString = "."
                End If
            End If
        End If
    Next i

'enable.Tag
    max_indx = cwBut_AxisEn.UBound
    For i = 0 To max_indx
        controller_param = Analyzer.GetSend(cwBut_AxisEn(i).Tag, True)
        sep_pos = InStr(controller_param, ">")
        If (sep_pos <> 0) Then
            If (LCase(Mid(controller_param, sep_pos + 1, 4)) = "acti") Then 'acti
               cwBut_AxisEn(i).Value = True
            End If
            If (LCase(Mid(controller_param, sep_pos + 1, 4)) = "pass") Then 'pass
               cwBut_AxisEn(i).Value = False
            End If
        End If
    Next i
    

    ' primary FF gains
    max_indx = cwNumFFgain.UBound
    For i = 0 To max_indx
        gain_cmd = cwNumFFgain(i).Tag & "?"
        controller_param = Analyzer.GetSend(gain_cmd, True)
        If (controller_param = "Timeout") Then Exit Sub
        If (controller_param = "") Then Exit Sub
        sep_pos = InStr(controller_param, "=")
        retval = Mid(controller_param, sep_pos + 1)
        If sep_pos < 3 Then sep_pos = 3 'to prevent errors
        If (Mid(controller_param, sep_pos - 1, 1) = "a") Then
            cwAdaptive(i).Value = True
        End If
        If (Mid(controller_param, sep_pos - 1, 1) = "n") Then
            cwAdaptive(i).Value = False
        End If

        If (Mid(controller_param, sep_pos - 2, 1) = "w") Then
            cwWorking(i).Value = True
        End If
        If (Mid(controller_param, sep_pos - 2, 1) = "p") Then
            cwWorking(i).Value = False
        End If

        sep_pos = InStr(retval, "//") ''if verbose response
        If (sep_pos <> 0) Then
            retval = Left(retval, sep_pos - 1)
        End If
        If IsNumber(retval) Then
            paramValue = Val(retval)
            cwNumFFgain(i).Value = paramValue
            If paramValue <> 0 Then
                cwNumFFgain(i).FormatString = ".##0E"
            Else
                cwNumFFgain(i).FormatString = "."
            End If
        End If
    Next i

'FF all.Tag
    controller_param = Analyzer.GetSend(cwBut_FF_ALL.Tag, True)
    sep_pos = InStr(controller_param, ">")
    If (sep_pos <> 0) Then
        retval = LCase(Mid(controller_param, sep_pos + 1, 4))
        If retval = "acti" Then
            cwBut_FF_ALL.Value = True
        Else 'pasive
            cwBut_FF_ALL.Value = False
        End If
    End If

'chkMotorsFF.Tag
    controller_param = Analyzer.GetSend(cwBut_FFmotors.Tag, True)
    sep_pos = InStr(controller_param, ">")
    If (sep_pos <> 0) Then
        retval = LCase(Mid(controller_param, sep_pos + 1, 4))
        If retval = "acti" Then
            cwBut_FFmotors.Value = True
        Else 'pasive
            cwBut_FFmotors.Value = False
        End If
    End If

    Init_sys_data = False
End Sub

